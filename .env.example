[TEMPLATE]
# =============================================================================
# SMTP Email Configuration (requires a network that allows SMTP ports 587/465)
# =============================================================================
# Copy this file to .env and fill in your credentials
# NOTE: For Gmail, you MUST use an App Password (not your regular password).
#       Generate one at: https://myaccount.google.com/apppasswords

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

# SMTP Alert Recipients (comma-separated for multiple)
ALERT_RECIPIENT=admin@example.com

# =============================================================================
# SendGrid API Configuration (uses HTTPS/443, bypasses ISP SMTP blocking)
# =============================================================================
# 1. Create a free SendGrid account: https://signup.sendgrid.com
# 2. Create an API key: Settings > API Keys > Create API Key (Full Access)
# 3. Verify a sender: Settings > Sender Authentication > Single Sender Verification
# 4. Set the values below (the "from" address must be verified in SendGrid)

SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM=your-verified-sender@example.com

# SendGrid Alert Recipients (comma-separated for multiple)
SENDGRID_RECIPIENT=admin@example.com

# =============================================================================
# Optional: Configurable Alert Thresholds (in days, comma-separated)
# =============================================================================
# ALERT_THRESHOLDS=30,14,7,3,1

# =============================================================================
# Optional: Monitoring Interval (in seconds)
# =============================================================================
# CHECK_INTERVAL=21600
